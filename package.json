{
  "name": "envhq-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @envhq/web dev",
    "build": "pnpm --filter @envhq/web build",
    "db:generate": "pnpm --filter @envhq/web db:generate",
    "db:migrate": "pnpm --filter @envhq/web db:migrate",
    "cli": "pnpm --filter envhq start"
  }
}
