{
  "name": "envhq",
  "version": "0.8.0",
  "description": "Sync your environment variables from the terminal — push/pull secrets to your EnvHQ projects.",
  "keywords": ["env", "dotenv", "environment-variables", "secrets", "cli", "sync", "envhq"],
  "license": "MIT",
  "author": "Anojan ST",
  "homepage": "https://github.com/anojanst/envhq#readme",
  "bugs": "https://github.com/anojanst/envhq/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anojanst/envhq.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "envhq": "./dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@envhq/parser": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
