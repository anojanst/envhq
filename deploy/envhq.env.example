# EnvHQ settings for deploy/docker-compose.yml. Copy to deploy/envhq.env.
# Also create deploy/.env containing POSTGRES_PASSWORD=<a long random value>.

# The URL people reach EnvHQ at (your reverse proxy). The OIDC redirect URI
# is <this>/auth/callback — register exactly that with your provider.
ENVHQ_PUBLIC_URL=https://envhq.example.com

# Your OpenID Connect provider (Entra ID, Okta, Google Workspace, Keycloak, …).
OIDC_ISSUER=https://login.example.com/
OIDC_CLIENT_ID=envhq
OIDC_CLIENT_SECRET=
# Only these email domains may sign in (verified emails only). Recommended.
OIDC_ALLOWED_EMAIL_DOMAINS=example.com

# Encrypts session cookies. `openssl rand -base64 48`. Changing it signs everyone out.
SESSION_SECRET=

# Optional: post new-error alerts to a Slack-compatible webhook.
# ALERT_WEBHOOK_URL=
