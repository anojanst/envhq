# Vite only exposes VITE_-prefixed vars to client code.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Build-time only (see vite.config.ts) — feeds the CSP's connect-src
# allow-list. Dev tenants look like <slug>.clerk.accounts.dev; production
# uses the custom Frontend API domain configured in the Clerk dashboard
# (e.g. clerk.envhq.dev). No scheme (no "https://").
VITE_CLERK_FRONTEND_API_DOMAIN=your-app-name.clerk.accounts.dev
