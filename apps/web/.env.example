# EnvHQ web app — copy to .env.local and fill in.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Next.js reads .env.local automatically; drizzle-kit loads it explicitly via
# dotenv (see drizzle.config.ts), so one file covers both the app and migrations.

# --- Database (required) ---------------------------------------------------
# Any Postgres instance — the app uses the postgres-js driver, so a local
# Postgres works as well as a hosted one. Production runs on Neon.
# postgres-js parses sslmode off this string, so set it here rather than
# elsewhere (e.g. ?sslmode=require for a hosted database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/envhq

# --- Database (optional) ---------------------------------------------------
# Connection pool size per process. Defaults to 10 when unset.
# DATABASE_POOL_MAX=10
#
# PEM contents of a custom root CA, for a database that requires one. When set,
# TLS is enabled with this CA and the certificate is verified.
# DATABASE_CA_CERT=

# --- Clerk auth (required) -------------------------------------------------
# From your Clerk application's API keys page (clerk.com).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk routing — these must match the app's own sign-in/sign-up routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk webhook signing secret (RM-6). From the Clerk dashboard's Webhooks
# page, on the endpoint you point at /api/webhooks/clerk (subscribe it to
# user.created, user.updated and user.deleted). It keeps the local
# `user_profiles` mirror fresh so display names cost no Clerk call per render.
#
# Without it that route refuses every delivery rather than trusting unsigned
# input — names then fall back to the batched lazy fill, and ultimately to raw
# user ids, so the app still works; it just stops being kept up to date.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Tests (optional) ------------------------------------------------------
# The authz-db and contract vitest projects need a real, disposable Postgres —
# they run migrations and truncate tables, so never point this at a database
# you care about. Not read by the app itself.
# TEST_DATABASE_URL=postgres://envhq_test:envhq_test@localhost:5432/envhq_test
