# EnvHQ web app — copy to .env.local and fill in.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Next.js reads .env.local automatically; drizzle-kit loads it explicitly via
# dotenv (see drizzle.config.ts), so one file covers both the app and migrations.

# --- Database (required) ---------------------------------------------------
# Any Postgres instance — the app uses the postgres-js driver, so a local
# Postgres works as well as a hosted one. Production runs on Neon.
# postgres-js parses sslmode off this string, so set it here rather than
# elsewhere (e.g. ?sslmode=require for a hosted database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/envhq

# --- Database (optional) ---------------------------------------------------
# Connection pool size PER INSTANCE. Defaults to 3 when unset.
#
# On Vercel every concurrent invocation is its own instance with its own pool,
# so the database sees instances x this, not this. Three is what one request
# actually needs; raise it to 10 when DATABASE_URL points at a pooled endpoint,
# where client connections are no longer real Postgres backends. The ceiling
# arithmetic is in docs/OPERATIONS.md.
# DATABASE_POOL_MAX=3
#
# Set to false to stop using named prepared statements. You almost certainly
# do not need this: postgres-js survives a transaction-mode pooler on its own
# (measured -- see docs/OPERATIONS.md), and leaving them on is faster both
# directly and behind a pooler that tracks statements. Only worth setting for
# a pooler in transaction mode that you know does not.
# DATABASE_PREPARE=false
#
# PEM contents of a custom root CA, for a database that requires one. When set,
# TLS is enabled with this CA and the certificate is verified.
# DATABASE_CA_CERT=

# --- Sign-in: OpenID Connect (required) -----------------------------------
# EnvHQ signs people in through any OIDC provider. For envhq.dev that's Clerk
# acting as an OIDC provider (Clerk dashboard → OAuth applications: add one
# with redirect URI <your URL>/auth/callback, scopes openid email profile, and
# the consent screen OFF). Self-hosted: your Okta / Entra ID / Google /
# Keycloak app registration, same redirect URI.
OIDC_ISSUER=https://your-provider.example.com
OIDC_CLIENT_ID=envhq
# Omit for a public client (PKCE only).
OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
#
# Only allow verified emails in these domains to sign in (comma-separated).
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
#
# After someone signs out, the next sign-in sends this OIDC prompt so the
# provider asks again (default "login"). Google ignores "login": use
# select_account there. Empty sends none.
# OIDC_SIGN_OUT_PROMPT=login
#
# The URL people reach EnvHQ at, if the server sees a different one (behind a
# reverse proxy). The redirect URI is built from it.
# ENVHQ_PUBLIC_URL=https://envhq.example.com

# Encrypts EnvHQ's own session cookie. At least 32 random characters, e.g.
#   openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# --- Operational visibility (optional, RM-18) ------------------------------
# Where a new-issue alert is posted. Any endpoint accepting {"text": "..."} —
# a Slack incoming webhook, an incident tool, your own relay. Unset means
# errors are still recorded and visible at /ops; nobody is told about them.
#
# Alerts fire on a NEW issue, and again only if it has been quiet for a day.
# Muting one is a click at /ops. An alert that fires constantly is an alert
# nobody reads, which is the failure this is shaped to avoid.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# Comma-separated user ids (the OIDC `sub`) allowed to see /ops and /api/ops/*. Unset or
# empty admits nobody, which is the correct default: this is EnvHQ's own
# numbers, not a customer's. Org admin is deliberately NOT sufficient — that
# means admin of a customer's org. A real staff role arrives with RM-17.
# ENVHQ_STAFF_USER_IDS=user_xxx,user_yyy
#
# Set automatically on Vercel; ties a recorded issue to the deploy it first
# appeared on. Set it yourself if you deploy elsewhere.
# GIT_COMMIT_SHA=

# --- Tests (optional) ------------------------------------------------------
# The authz-db, orgs-db and contract vitest projects need a real, disposable Postgres —
# they run migrations and truncate tables, so never point this at a database
# you care about. Not read by the app itself.
# TEST_DATABASE_URL=postgres://envhq_test:envhq_test@localhost:5432/envhq_test
